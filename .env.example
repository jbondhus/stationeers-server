# Timezone (e.g. America/Chicago, Europe/London, UTC)
TZ=UTC

# Server identity -- used as the container name suffix and data subdirectory
SERVER_NAME=mars

# In-game display name shown in the server browser (defaults to SERVER_NAME if empty)
DISPLAY_NAME=

# Ports (UDP). Each world has its own tailnet node, so ports need not differ between worlds; keeping them unique anyway makes
# an env file unambiguous.
GAME_PORT=27016
UPDATE_PORT=27015

# Tailscale node for this world (the sidecar). TS_AUTHKEY: a one-off, tagged, non-reusable key from the admin console; it is read
# only on the first start, until the node's state exists. TS_TAG must be a tag the key may carry. Share the node with friends from
# the console; they join at <node address>:GAME_PORT.
TS_AUTHKEY=
TS_TAG=tag:house-game

# Memory limit for the game container (a loaded world holds about 7 GiB)
MEM_LIMIT=8g

# World settings
# World types: Mars2, Lunar, Europa3, MimasHerschel, Vulcan, Venus
WORLD_TYPE=Mars2
WORLD_DIFFICULTY=Normal

# Save name (creates/loads saves/<SAVE_NAME> inside the server directory)
SAVE_NAME=default

# Server visibility and access. SERVER_VISIBLE lists the server in the public browser with the host's internet address; off, since
# the server is reached over the tailnet only.
SERVER_VISIBLE=false
SERVER_PASSWORD=
SERVER_AUTH_SECRET=
MAX_PLAYERS=10

# Auto-save settings
AUTO_SAVE=true
SAVE_INTERVAL=300

# Pause when no players are connected
AUTO_PAUSE=true
